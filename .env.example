# Required for production builds, canonical URLs, sitemap and robots.txt.
VITE_SITE_URL=https://shop.example.com

# F14D backend integration.
# `live` is fail-closed: no prototype catalogue/order/payment fallback is used.
# `prototype` keeps the pre-F14D frontend-only experience for local visual work.
VITE_LBB_BACKEND_MODE=live
VITE_LBB_API_BASE_URL=https://api.example.com

# Server-only credential used only by the SSR runtime for Backend API calls.
# Never rename or duplicate this as a VITE_* variable because VITE_* values are browser-exposed.
LBB_SSR_RATE_LIMIT_TOKEN=

# The frontend code pins the accepted backend contract version:
# 2026-09-06-p3-storefront-v1

# Optional when the Playwright server is hosted externally.
# PLAYWRIGHT_BASE_URL=https://shop.example.com
